<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The window is a fixed light surface, straight from the design handoff:
         the paper/ink relationship is the design, not the system's idea of a
         control background. Every value below is a token from that handoff, and
         its CSS pixels are WPF units one for one. -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Paper" Color="#FBF9F4" />
    <SolidColorBrush x:Key="PaperSunken" Color="#F8F5EC" />
    <SolidColorBrush x:Key="Chrome" Color="#F1ECE1" />
    <SolidColorBrush x:Key="Field" Color="#F6F2E8" />
    <SolidColorBrush x:Key="Strip" Color="#F4EFE3" />

    <!-- Lines -->
    <SolidColorBrush x:Key="StripBorder" Color="#E4DCC9" />
    <SolidColorBrush x:Key="Border" Color="#E4DDCC" />
    <SolidColorBrush x:Key="BorderSoft" Color="#EDE7D9" />
    <SolidColorBrush x:Key="BorderRow" Color="#EFEADD" />
    <SolidColorBrush x:Key="KeycapEdge" Color="#DCD3BF" />

    <!-- Text -->
    <SolidColorBrush x:Key="Ink" Color="#1B1917" />
    <SolidColorBrush x:Key="InkHover" Color="#332F29" />
    <SolidColorBrush x:Key="Ink2" Color="#3D3931" />
    <SolidColorBrush x:Key="Ink3" Color="#514C44" />
    <SolidColorBrush x:Key="Muted" Color="#6E685D" />
    <SolidColorBrush x:Key="Muted2" Color="#8C8577" />
    <SolidColorBrush x:Key="Muted3" Color="#9A9384" />
    <SolidColorBrush x:Key="Muted4" Color="#A8A192" />

    <!-- Local and ready -->
    <SolidColorBrush x:Key="Green" Color="#4E7F62" />
    <SolidColorBrush x:Key="GreenInk" Color="#33604A" />
    <SolidColorBrush x:Key="GreenBg" Color="#EDF2EC" />
    <SolidColorBrush x:Key="GreenBorder" Color="#C4D4C6" />
    <SolidColorBrush x:Key="GreenMeta" Color="#6E9179" />

    <!-- Listening, and anything that destroys -->
    <SolidColorBrush x:Key="Clay" Color="#9A6045" />
    <SolidColorBrush x:Key="ClayHover" Color="#7E4630" />
    <SolidColorBrush x:Key="ClayBg" Color="#F6EDE6" />
    <SolidColorBrush x:Key="ClayBorder" Color="#E0C8B6" />

    <!-- Working: the model is busy -->
    <SolidColorBrush x:Key="WorkingBg" Color="#F1EEE3" />
    <SolidColorBrush x:Key="WorkingBorder" Color="#DCD3BF" />

    <!-- The serif/sans/mono split is the identity; Georgia, Segoe UI and Cascadia
         Mono stand in for Newsreader, Instrument Sans and JetBrains Mono. -->
    <FontFamily x:Key="Serif">Georgia, Times New Roman</FontFamily>
    <FontFamily x:Key="Sans">Segoe UI</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- A mono section label: "LIBRARY", "THIS WEEK", "TODAY". -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource Muted3}" />
    </Style>

    <Style x:Key="MetaLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Muted3}" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Ink2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A sidebar navigation row: paper and a border when it is the pane on screen. -->
    <Style x:Key="NavItem" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Field}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A plain text link: the sidebar footer, "Export all", the sort control. -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Ink3}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DestructiveLink" TargetType="Button" BasedOn="{StaticResource LinkButton}">
        <Setter Property="Foreground" Value="{StaticResource Clay}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource ClayHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The onboarding strip's two actions. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Paper}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell" CornerRadius="8" Padding="16,9"
                            Background="{StaticResource Ink}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background"
                                    Value="{StaticResource InkHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Ink2}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell" CornerRadius="8" Padding="16,9"
                            Background="Transparent" BorderThickness="1"
                            BorderBrush="{StaticResource KeycapEdge}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush"
                                    Value="{StaticResource Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "Copy" and "Insert" on a transcript row: visible at rest, by design. The
         old build revealed them on hover, which left the action invisible. -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Ink3}" />
        <Setter Property="Background" Value="{StaticResource Paper}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- The shell takes its colours from the button, so a destructive variant
             is a handful of setters rather than a second template. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="6" Padding="12,6"
                            Background="{TemplateBinding Background}" BorderThickness="1"
                            BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- "Delete" on a row. It takes two clicks, so it is never dressed as the
         quiet sibling of Copy and Insert: clay at rest, clay under the pointer. -->
    <Style x:Key="RowButtonDestructive" TargetType="Button" BasedOn="{StaticResource RowButton}">
        <Setter Property="Foreground" Value="{StaticResource Clay}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Clay}" />
                <Setter Property="Foreground" Value="{StaticResource ClayHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- An armed delete: the second click is the one that acts. -->
    <Style x:Key="RowButtonArmed" TargetType="Button" BasedOn="{StaticResource RowButton}">
        <Setter Property="Foreground" Value="{StaticResource Paper}" />
        <Setter Property="Background" Value="{StaticResource Clay}" />
        <Setter Property="BorderBrush" Value="{StaticResource Clay}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ClayHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource ClayHover}" />
                <Setter Property="Foreground" Value="{StaticResource Paper}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The "···" overflow on a row, and the "✕" that dismisses the strip. -->
    <Style x:Key="RowGlyph" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Muted4}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="6,2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The search box: a bare TextBox, so the field's own border is the design. -->
    <Style x:Key="SearchField" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- A click focuses the scroller or the grid; WPF's default focus visual is a
         dotted rectangle around the whole thing, which reads as damage here. -->
    <Style TargetType="ScrollViewer">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!-- Editable dictionary tables. -->
    <Style TargetType="DataGrid">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Field}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Border}" />
        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

</ResourceDictionary>
