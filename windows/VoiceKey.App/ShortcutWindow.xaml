<Window x:Class="VoiceKey.App.ShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceKey Shortcut" Height="150" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Paper}" Topmost="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
        <TextBlock Text="Press the new shortcut." HorizontalAlignment="Center"
                   FontFamily="{StaticResource Serif}" FontSize="17"
                   Foreground="{StaticResource Ink}" />
        <TextBlock Text="Must include Ctrl, Alt or Win — Esc cancels."
                   HorizontalAlignment="Center" Margin="0,8,0,0"
                   FontFamily="{StaticResource Serif}" FontSize="14"
                   Foreground="{StaticResource Ink3}" />
    </StackPanel>
</Window>
