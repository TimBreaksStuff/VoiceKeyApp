<UserControl x:Class="VoiceKey.App.TranscriptsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <!-- Onboarding: a strip that keeps the keycap visible, not a screenful. -->
        <Border x:Name="OnboardingStrip" Grid.Row="0" Visibility="Collapsed"
                Margin="32,20,32,4" Padding="18,16" CornerRadius="12"
                Background="{StaticResource Strip}"
                BorderBrush="{StaticResource StripBorder}" BorderThickness="1">
            <DockPanel>
                <!-- The keycap's one shadow: a hard 1.5px edge underneath it. -->
                <Border DockPanel.Dock="Left" CornerRadius="7" Margin="0,0,20,0"
                        Background="{StaticResource KeycapEdge}" VerticalAlignment="Center">
                    <Border CornerRadius="7" Padding="11,7" Margin="0,0,0,1.5"
                            Background="{StaticResource Paper}"
                            BorderBrush="{StaticResource KeycapEdge}" BorderThickness="1">
                        <TextBlock x:Name="Keycap" FontFamily="{StaticResource Mono}" FontSize="14"
                                   Foreground="{StaticResource Ink}" />
                    </Border>
                </Border>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="20,0,0,0"
                            VerticalAlignment="Center">
                    <Button Content="Show me how" Style="{StaticResource PrimaryButton}"
                            Click="OnWalkthroughClicked" />
                    <Button Content="Change shortcut" Style="{StaticResource GhostButton}"
                            Margin="10,0,0,0" Click="OnChangeShortcutClicked" />
                    <Button Content="&#x2715;" Style="{StaticResource RowGlyph}" Margin="10,0,0,0"
                            ToolTip="Dismiss" Click="OnDismissOnboardingClicked" />
                </StackPanel>

                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="15"
                           LineHeight="22" Foreground="{StaticResource Ink2}"
                           Text="Hold anywhere in Windows and speak. On release VoiceKey types the text into whatever has focus — dictionary spellings and punctuation already applied." />
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,20">
            <StackPanel x:Name="Groups" KeyboardNavigation.DirectionalNavigation="Contained" />
        </ScrollViewer>

        <!-- Nothing dictated yet, or nothing that matches the search. -->
        <StackPanel x:Name="EmptyState" Grid.Row="1" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="EmptyTitle" FontFamily="{StaticResource Serif}" FontSize="22"
                       Foreground="{StaticResource Ink3}" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyHint" Margin="0,10,0,0" HorizontalAlignment="Center"
                       FontFamily="{StaticResource Mono}" FontSize="12"
                       Foreground="{StaticResource Muted3}" />
        </StackPanel>

        <!-- An in-window confirmation; fades itself out, and carries the undo. -->
        <Border x:Name="Toast" Grid.Row="1" Opacity="0" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24" CornerRadius="9" Padding="16,10"
                Background="{StaticResource Ink}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastLabel" FontSize="14" VerticalAlignment="Center"
                           Foreground="{StaticResource Paper}" />
                <Button x:Name="ToastAction" Content="Undo" Margin="16,0,0,0"
                        Visibility="Collapsed" Style="{StaticResource LinkButton}"
                        FontWeight="Medium" Foreground="{StaticResource GreenMeta}"
                        Click="OnUndoClicked" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource PaperSunken}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0">
            <Grid Margin="32,0">
                <TextBlock x:Name="StorageLine" Style="{StaticResource MetaLabel}"
                           VerticalAlignment="Center" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="Export all" FontSize="13" Style="{StaticResource LinkButton}"
                            Click="OnExportAllClicked" />
                    <Button x:Name="DeleteAllButton" Content="Delete all transcripts" FontSize="13"
                            Margin="18,0,0,0" Style="{StaticResource DestructiveLink}"
                            AutomationProperties.AutomationId="DeleteAllTranscripts"
                            Click="OnDeleteAllClicked" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
