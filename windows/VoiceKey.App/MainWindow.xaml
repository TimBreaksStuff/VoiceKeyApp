<Window x:Class="VoiceKey.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceKey" Height="900" Width="1440" MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Paper}"
        FontFamily="{StaticResource Sans}"
        TextOptions.TextFormattingMode="Ideal">

    <!-- A fixed 236px sidebar and a fixed 76px header over one scrolling pane.
         Every number is the design handoff's, in CSS pixels — which are WPF
         units one for one. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="{StaticResource Chrome}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,22,24,26">
                <TextBlock Text="VoiceKey" FontFamily="{StaticResource Serif}" FontSize="23"
                           FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                           VerticalAlignment="Center" />
                <Border CornerRadius="5" Margin="10,0,0,0" Padding="6,2"
                        Background="{StaticResource GreenBg}"
                        BorderBrush="{StaticResource GreenBorder}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="LOCAL" FontFamily="{StaticResource Mono}" FontSize="10"
                               Foreground="{StaticResource Green}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="16,0,16,0">
                <TextBlock Text="LIBRARY" Style="{StaticResource SectionLabel}"
                           Margin="8,0,8,8" />
                <Border x:Name="NavTranscripts" Style="{StaticResource NavItem}"
                        MouseLeftButtonUp="OnTranscriptsClicked">
                    <DockPanel>
                        <TextBlock x:Name="NavTranscriptsCount" DockPanel.Dock="Right"
                                   FontFamily="{StaticResource Mono}" FontSize="12"
                                   Foreground="{StaticResource Muted2}" VerticalAlignment="Center" />
                        <TextBlock x:Name="NavTranscriptsLabel" Text="Transcripts" FontSize="15"
                                   Foreground="{StaticResource Ink}" />
                    </DockPanel>
                </Border>
                <Border x:Name="NavDictionary" Style="{StaticResource NavItem}" Margin="0,2,0,0"
                        MouseLeftButtonUp="OnDictionaryClicked">
                    <DockPanel>
                        <TextBlock x:Name="NavDictionaryCount" DockPanel.Dock="Right"
                                   FontFamily="{StaticResource Mono}" FontSize="12"
                                   Foreground="{StaticResource Muted3}" VerticalAlignment="Center" />
                        <TextBlock x:Name="NavDictionaryLabel" Text="Dictionary" FontSize="15"
                                   Foreground="{StaticResource Ink3}" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Honest labels: what was dictated this week, not a vanity streak. -->
            <Border Grid.Row="3" Margin="16,26,16,0" CornerRadius="10" Padding="14"
                    Background="{StaticResource Paper}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="THIS WEEK" Style="{StaticResource SectionLabel}"
                               Margin="0,0,0,10" />
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock x:Name="WeekWords" DockPanel.Dock="Right"
                                   FontFamily="{StaticResource Serif}" FontSize="19"
                                   Foreground="{StaticResource Ink}" />
                        <TextBlock Text="Words dictated" FontSize="14"
                                   Foreground="{StaticResource Ink3}" VerticalAlignment="Bottom" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock x:Name="WeekPace" DockPanel.Dock="Right"
                                   FontFamily="{StaticResource Serif}" FontSize="19"
                                   Foreground="{StaticResource Ink}" />
                        <TextBlock Text="Average pace" FontSize="14"
                                   Foreground="{StaticResource Ink3}" VerticalAlignment="Bottom" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock x:Name="WeekSaved" DockPanel.Dock="Right"
                                   FontFamily="{StaticResource Serif}" FontSize="19"
                                   Foreground="{StaticResource Ink}" />
                        <TextBlock Text="Typing saved" FontSize="14"
                                   Foreground="{StaticResource Ink3}" VerticalAlignment="Bottom" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="4" Margin="16,16,16,18">
                <Rectangle Height="1" Fill="{StaticResource Border}" Margin="0,0,0,16" />
                <Button Content="Shortcut" Style="{StaticResource LinkButton}"
                        Click="OnShortcutClicked" />
                <Button Content="Diagnostics log" Style="{StaticResource LinkButton}"
                        Margin="0,10,0,0" Click="OnLogClicked" />
                <Button x:Name="HelpLink" Content="Help &amp; shortcuts"
                        Style="{StaticResource LinkButton}"
                        Margin="0,10,0,0" Click="OnHelpClicked" />
            </StackPanel>

            <!-- Help opens beside whatever asked for it, not as a modal dialog:
                 the shortcut is easier to try while the window is still there. -->
            <Popup x:Name="HelpPopup" StaysOpen="False" AllowsTransparency="True"
                   HorizontalOffset="8" VerticalOffset="8">
                <Border x:Name="HelpCard" Background="{StaticResource Paper}" CornerRadius="10"
                        Padding="18,16" MaxWidth="380"
                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Dictating with VoiceKey"
                                   FontFamily="{StaticResource Serif}" FontSize="17"
                                   Foreground="{StaticResource Ink}" Margin="0,0,0,12" />
                        <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="21"
                                   Foreground="{StaticResource Ink2}"
                                   Text="1. Put the cursor where the text should go — any app, any field." />
                        <TextBlock x:Name="HelpHoldStep" Margin="0,8,0,0" TextWrapping="Wrap"
                                   FontSize="14" LineHeight="21" Foreground="{StaticResource Ink2}" />
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="14" LineHeight="21"
                                   Foreground="{StaticResource Ink2}"
                                   Text="3. VoiceKey transcribes on this PC and types the text at the cursor." />
                        <Rectangle Height="1" Fill="{StaticResource BorderRow}" Margin="0,14,0,12" />
                        <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                   Foreground="{StaticResource Ink3}"
                                   Text="Words it keeps mishearing belong in the Dictionary. The shortcut itself can be changed below." />
                        <Button Content="Change shortcut" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left" Margin="0,14,0,0"
                                Click="OnHelpShortcutClicked" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <Rectangle Grid.Column="1" Fill="{StaticResource Border}" />

        <!-- Header over the pane -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="32,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock x:Name="PaneTitle" Text="Transcripts"
                               FontFamily="{StaticResource Serif}" FontSize="27"
                               Foreground="{StaticResource Ink}" />
                    <TextBlock x:Name="DateLabel" Margin="0,3,0,0"
                               Style="{StaticResource MetaLabel}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Border x:Name="SearchShell" Width="280" Height="38" CornerRadius="9"
                            Background="{StaticResource Field}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            Padding="12,0">
                        <DockPanel>
                            <TextBlock Text="&#x2315;" DockPanel.Dock="Left" Margin="0,0,9,0"
                                       FontFamily="{StaticResource Mono}" FontSize="13"
                                       Foreground="{StaticResource Muted3}"
                                       VerticalAlignment="Center" />
                            <Grid>
                                <TextBlock x:Name="SearchPlaceholder" Text="Search transcripts"
                                           FontSize="14" Foreground="{StaticResource Muted3}"
                                           IsHitTestVisible="False" VerticalAlignment="Center" />
                                <TextBox x:Name="SearchBox" Style="{StaticResource SearchField}"
                                         TextChanged="OnSearchChanged" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border x:Name="StatusPillShell" Height="38" CornerRadius="9" Padding="14,0"
                            Margin="12,0,0,0" BorderThickness="1" Cursor="Hand"
                            MouseLeftButtonUp="OnStatusPillClicked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                     VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="StatusDotScale" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <TextBlock x:Name="StatusLabel" Margin="8,0,0,0" FontSize="14"
                                       FontWeight="Medium" VerticalAlignment="Center" />
                            <TextBlock Text="· on-device" Margin="8,0,0,0"
                                       FontFamily="{StaticResource Mono}" FontSize="11"
                                       Foreground="{StaticResource GreenMeta}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- The granular state the old design showed inline, one click away. -->
                    <Popup x:Name="PermissionPopup" PlacementTarget="{Binding ElementName=StatusPillShell}"
                           Placement="Bottom" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{StaticResource Paper}" CornerRadius="9" Padding="14,12"
                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <StackPanel x:Name="PermissionLines" />
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>

            <Rectangle Grid.Row="1" Fill="{StaticResource BorderSoft}" />

            <ContentControl x:Name="PaneHost" Grid.Row="2" />
        </Grid>
    </Grid>
</Window>
